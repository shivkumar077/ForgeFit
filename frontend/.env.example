# ForgeFit Frontend - Environment Configuration
#
# When deploying to Vercel (or testing against a hosted FastAPI backend),
# set VITE_API_BASE_URL to your Render backend service URL.
#
# Example:
# VITE_API_BASE_URL=https://YOUR-RENDER-SERVICE.onrender.com/api
#
# For local same-origin development (FastAPI serving the built frontend or Vite proxy),
# leave this unset or set to /api.
VITE_API_BASE_URL=
